		"@tailwindcss/vite": "4.3.2",
		"@types/node": "24.13.2",
		"bits-ui": "2.18.1",
		"clsx": "2.1.1",
		"eslint": "10.6.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.20.0",
		"globals": "17.7.0",
		"mode-watcher": "1.1.0",
